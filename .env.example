# Copy this file to .env before running `docker compose up`:
#   cp .env.example .env
#
# The values below are local-only development defaults for a Postgres container that is not
# reachable from outside this machine. They are placeholders, not real secrets - do not reuse
# them anywhere real, and never commit a real .env file (it is gitignored).
POSTGRES_DB=switchyard
POSTGRES_USER=switchyard
POSTGRES_PASSWORD=switchyard_dev_only
POSTGRES_PORT=5455
